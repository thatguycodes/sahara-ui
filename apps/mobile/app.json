{
  "expo": {
    "name": "thatguycodes",
    "slug": "thatguycodes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161311"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thatguycodes.designsystem"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161311"
      },
      "package": "com.thatguycodes.designsystem"
    },
    "plugins": []
  }
}
